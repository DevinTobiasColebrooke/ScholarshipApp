<div class="max-w-xl mx-auto py-12 px-4">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-gray-900">Campaign Planner</h1>
    <p class="mt-2 text-gray-600">Step 1: Name your campaign and select your target audience.</p>
  </div>

  <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
    <%= form_with url: outreach_planner_index_path, method: :post, local: true, class: "space-y-6" do |form| %>
      
      <%# Campaign Name %>
      <div>
        <%= form.label :campaign_name, "Campaign Name", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= form.text_field :campaign_name, 
            value: "Campaign #{Time.current.strftime('%Y-%m-%d')}", 
            class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
            placeholder: "e.g. Winter Scholarship Outreach" %>
      </div>

      <%# Profile Selection %>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-3">Target Audience Profile</label>
        <div class="space-y-3">
          <% @profile_presets.each do |key, label| %>
            <div class="flex items-center p-3 border rounded-lg hover:bg-gray-50 cursor-pointer">
              <%= form.radio_button :profile_scope_name, key, id: key, checked: true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" %>
              <%= form.label key, class: "ml-3 block text-sm font-medium text-gray-700 w-full cursor-pointer" do %>
                <%= label %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="pt-4">
        <%= form.submit "Next: View Stats & Strategy", 
            class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>