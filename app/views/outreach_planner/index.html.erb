<div class="max-w-xl mx-auto py-12 px-4">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-gray-900">Campaign Planner</h1>
    <p class="mt-2 text-gray-600">Start a new automated outreach campaign.</p>
  </div>

  <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
    <%= form_with url: outreach_planner_index_path, method: :post, local: true, class: "space-y-8" do |form| %>
      
      <%# Campaign Name %>
      <div>
        <%= form.label :campaign_name, "Campaign Name", class: "block text-sm font-bold text-gray-700 mb-1" %>
        <%= form.text_field :campaign_name, 
            value: "Campaign #{Time.current.strftime('%Y-%m-%d')}", 
            class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
            placeholder: "e.g. Winter Scholarship Outreach" %>
      </div>

      <%# Outreach Method Selection %>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-3">Outreach Method</label>
        <div class="grid grid-cols-1 gap-4">
          
          <label class="relative flex items-start p-4 border rounded-lg hover:bg-indigo-50 cursor-pointer transition border-gray-200 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 ring-0 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
            <div class="flex items-center h-5">
              <%= form.radio_button :outreach_type, "combined", checked: true, class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
            </div>
            <div class="ml-3 text-sm">
              <span class="block font-medium text-gray-900">Hybrid (Email + Mail)</span>
              <span class="block text-gray-500">Send emails where available. Mark others for physical mailing.</span>
            </div>
          </label>

          <label class="relative flex items-start p-4 border rounded-lg hover:bg-green-50 cursor-pointer transition border-gray-200 has-[:checked]:border-green-500 has-[:checked]:bg-green-50 ring-0 has-[:checked]:ring-1 has-[:checked]:ring-green-500">
            <div class="flex items-center h-5">
              <%= form.radio_button :outreach_type, "email_only", class: "h-4 w-4 text-green-600 border-gray-300 focus:ring-green-500" %>
            </div>
            <div class="ml-3 text-sm">
              <span class="block font-medium text-gray-900">Email Only</span>
              <span class="block text-gray-500">Skip organizations without email addresses.</span>
            </div>
          </label>

          <label class="relative flex items-start p-4 border rounded-lg hover:bg-orange-50 cursor-pointer transition border-gray-200 has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50 ring-0 has-[:checked]:ring-1 has-[:checked]:ring-orange-500">
            <div class="flex items-center h-5">
              <%= form.radio_button :outreach_type, "mail_only", class: "h-4 w-4 text-orange-600 border-gray-300 focus:ring-orange-500" %>
            </div>
            <div class="ml-3 text-sm">
              <span class="block font-medium text-gray-900">Physical Mail Only</span>
              <span class="block text-gray-500">Do not send emails. Prepare mailing list for everyone.</span>
            </div>
          </label>
        </div>
      </div>

      <%# Profile Selection %>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-3">Target Audience Profile</label>
        <div class="space-y-3">
          <% @profile_presets.each do |key, label| %>
            <div class="flex items-center p-3 border rounded-lg hover:bg-gray-50 cursor-pointer">
              <%= form.radio_button :profile_scope_name, key, id: key, checked: true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" %>
              <%= form.label key, class: "ml-3 block text-sm font-medium text-gray-700 w-full cursor-pointer" do %>
                <%= label %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="pt-4">
        <%= form.submit "Next: Review Campaign", 
            class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>