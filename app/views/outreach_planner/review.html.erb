<div class="max-w-7xl mx-auto py-8 px-4">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Review Recipients</h1>
      <p class="text-gray-600 mt-1">
        Found <strong><%= number_with_delimiter(@total_recipients) %></strong> organizations for <strong><%= @campaign_name %></strong>
      </p>
    </div>
    
    <%= button_to "Start Campaign Now", 
        outreach_contacts_path, 
        method: :post,
        params: { 
          profile_name: @profile_scope_name, 
          campaign_name: @campaign_name,
          outreach_type: @outreach_type
        },
        data: { turbo_confirm: "Start processing #{@total_recipients} organizations?" },
        class: "bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg shadow-lg transform transition hover:-translate-y-0.5" %>
  </div>

  <%= turbo_frame_tag "outreach_review_results" do %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Organization</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Current Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action Plan</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @campaign_organizations.each do |org| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-indigo-600"><%= org.name %></div>
                <div class="text-xs text-gray-500"><%= org.ein %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= org.org_contact_email.presence || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                 <% if org.outreach_contact %>
                   <span class="px-2 py-1 rounded-full text-xs font-semibold <%= org.outreach_contact.status_color_class %>">
                     <%= org.outreach_contact.status.humanize %>
                   </span>
                 <% else %>
                   <span class="text-gray-400 text-xs">New / Untouched</span>
                 <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <% if @outreach_type == "mail_only" %>
                  <span class="text-orange-600 bg-orange-50 px-2 py-1 rounded">Prepare Mail</span>
                <% elsif org.org_contact_email.present? %>
                  <span class="text-green-600 bg-green-50 px-2 py-1 rounded">Send Email</span>
                <% else %>
                  <% if @outreach_type == "email_only" %>
                    <span class="text-gray-400">Skip</span>
                  <% else %>
                    <span class="text-orange-600 bg-orange-50 px-2 py-1 rounded">Prepare Mail</span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <div class="py-6 flex justify-center">
        <% if @pagy %>
          <%== @pagy.series_nav(data: { turbo_frame: "outreach_review_results" }) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>