<div class="max-w-xl mx-auto py-10 w-full">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Campaign Summary</h1>
    <%= link_to "Edit", outreach_planner_index_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100 space-y-6">
    
    <%# Info Block %>
    <div class="border-b pb-4 grid grid-cols-2 gap-4">
      <div>
        <p class="text-xs text-gray-500 uppercase font-bold">Campaign</p>
        <p class="text-lg font-bold text-gray-900"><%= @campaign_name %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase font-bold">Method</p>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
          <%= @outreach_type.humanize %>
        </span>
      </div>
    </div>

    <%# Stats Block %>
    <div>
      <h3 class="text-lg font-semibold text-gray-800 mb-3">Target Audience</h3>
      
      <div class="bg-gray-50 p-6 rounded-xl text-center mb-4">
        <span class="block text-4xl font-extrabold text-gray-900"><%= number_with_delimiter(@total_target_count) %></span>
        <span class="text-sm text-gray-600 font-medium">Recipients in this Campaign</span>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <% if @outreach_type == "mail_only" %>
          <div class="col-span-2 bg-orange-50 p-4 rounded-lg text-center border border-orange-100">
            <span class="block text-2xl font-bold text-orange-700"><%= number_with_delimiter(@orgs_needs_mail_count) %></span>
            <span class="text-xs text-orange-600 font-bold uppercase">To Physical Mail</span>
          </div>
        <% else %>
          <%# Email Stats %>
          <div class="bg-green-50 p-4 rounded-lg text-center border border-green-100">
            <span class="block text-2xl font-bold text-green-700"><%= number_with_delimiter(@orgs_with_email_count) %></span>
            <span class="text-xs text-green-600 font-bold uppercase">Via Email</span>
          </div>
          
          <%# Mail/Skipped Stats %>
          <% if @outreach_type == "email_only" %>
             <div class="bg-gray-100 p-4 rounded-lg text-center border border-gray-200 opacity-75">
              <span class="block text-2xl font-bold text-gray-500"><%= number_with_delimiter(@orgs_skipped_count) %></span>
              <span class="text-xs text-gray-500 font-bold uppercase">Skipped (No Email)</span>
            </div>
          <% else %>
            <div class="bg-orange-50 p-4 rounded-lg text-center border border-orange-100">
              <span class="block text-2xl font-bold text-orange-700"><%= number_with_delimiter(@orgs_needs_mail_count) %></span>
              <span class="text-xs text-orange-600 font-bold uppercase">Via Mail</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="pt-4">
      <%= link_to "Continue to Review List →", 
          review_outreach_planner_index_path, 
          class: "block w-full text-center py-3 px-4 bg-indigo-600 text-white font-bold rounded-lg shadow hover:bg-indigo-700 transition duration-200" %>
    </div>
  </div>
</div>